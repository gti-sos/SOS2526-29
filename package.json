{
  "name": "sos2526-29",
  "version": "1.0.0",
  "description": "Proyecto SOS2526-29",
  "homepage": "https://github.com/gti-sos/SOS2526-29#readme",
  "bugs": {
    "url": "https://github.com/gti-sos/SOS2526-29/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gti-sos/SOS2526-29.git"
  },
  "license": "ISC",
  "author": "Alberto Lirola",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test-ALG": "newman run ./tests/ALG/pruebas-alg.json -e ./tests/ALG/local_env.json",
    "test-online-ALG": "newman run ./tests/ALG/pruebas-alg.json -e ./tests/ALG/online_env.json",
    "test-LCC": "newman run ./tests/LCC/pruebas-lcc.json -e ./tests/LCC/local_env.json",
    "test-online-LCC": "newman run ./tests/LCC/pruebas-lcc.json -e ./tests/LCC/online_env.json",
    "test-RMP": "newman run ./tests/RMP/pruebas-rmp.json -e ./tests/RMP/local_env.json",
    "test-online-RMP": "newman run ./tests/RMP/pruebas-rmp.json -e ./tests/RMP/online_env.json",
    "test-local": "start-server-and-test start http://localhost:10000 \"npm run test-ALG && npm run test-RMP && npm run test-LCC\"",
    "test-online": "npm run test-online-ALG && npm run test-online-RMP && npm run test-online-LCC",
    "test": "npm run test-local && npm run test-online"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "newman": "^6.2.2",
    "start-server-and-test": "^2.1.5"
  }
}
